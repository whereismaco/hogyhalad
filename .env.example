# ==============================================================================
# CLEANFLOW SAAS CRM - PÉLDA KÖRNYEZETI VÁLTOZÓK (.env.example)
# ==============================================================================
# Másold át .env.local néven, és töltsd ki a saját kulcsaiddal!
# ==============================================================================

# 1. ALKALMAZÁS & ALAPBEÁLLÍTÁSOK
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CleanFlow"

# 2. ADATBÁZIS (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-pooler.region.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep.region.neon.tech/dbname?sslmode=require"

# 3. HITELESÍTÉS (Clerk Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# 4. KÉP- ÉS FÁJLTÁRHELY (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cleanflow-files"
NEXT_PUBLIC_R2_PUBLIC_URL=""

# 5. ÉRTESÍTŐ EMAILEK (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="CleanFlow CRM <ertesito@cleanflow.hu>"

# 6. MESTERSÉGES INTELLIGENCIA (OpenAI)
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"

# 7. ELŐFIZETÉSEK & STRIPE FIZETÉS
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_YEARLY="price_..."
STRIPE_PRICE_BUSINESS_MONTHLY="price_..."
STRIPE_PRICE_BUSINESS_YEARLY="price_..."
STRIPE_PRICE_AI_CREDITS_250="price_..."
STRIPE_PRICE_AI_CREDITS_550="price_..."
STRIPE_PRICE_AI_CREDITS_1200="price_..."

# 8. SZÁMLÁZÁS (Számlázz.hu / Billingo)
SZAMLAZZ_AGENT_KEY=""
BILLINGO_API_KEY=""

# 9. TÉRKÉP & GEOKÓDOLÁS
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
