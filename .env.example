# HogyHalad — reference only. Cloudflare reads local secrets from ignored .dev.vars.
# Run: node scripts/dev-setup.mjs
# Production values belong in Wrangler secrets; never commit keys.
APP_URL=http://localhost:3000
ENVIRONMENT=development
EMAIL_DOMAIN=hogyhalad.hu
AUTH_FROM=HogyHalad <belepes@hogyhalad.hu>
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Platform's own invoicing account; tenants configure their own inside the app.
INVOICE_PROVIDER=
INVOICE_API_KEY=
INVOICE_BLOCK_ID=
SELLER_TAX_MODE=
SELLER_NAME=
SELLER_ADDRESS=
