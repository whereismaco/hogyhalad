{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hogyhalad-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "http://localhost:3000",
    "ENVIRONMENT": "development",
    "EMAIL_DOMAIN": "hogyhalad.hu",
    "AUTH_FROM": "HogyHalad <belepes@hogyhalad.hu>",
    "OPENAI_MODEL": "gpt-6-luna"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hogyhalad-development",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "hogyhalad-development-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASKS",
        "queue": "hogyhalad-development-tasks"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "hogyhalad-staging",
      "vars": {
        "APP_URL": "https://staging.hogyhalad.hu",
        "ENVIRONMENT": "staging",
        "EMAIL_DOMAIN": "hogyhalad.hu",
        "AUTH_FROM": "HogyHalad <belepes@hogyhalad.hu>",
        "OPENAI_MODEL": "gpt-6-luna"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hogyhalad-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "hogyhalad-staging-files"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "TASKS",
            "queue": "hogyhalad-staging-tasks"
          }
        ]
      }
    },
    "production": {
      "name": "hogyhalad-production",
      "vars": {
        "APP_URL": "https://hogyhalad.hu",
        "ENVIRONMENT": "production",
        "EMAIL_DOMAIN": "hogyhalad.hu",
        "AUTH_FROM": "HogyHalad <belepes@hogyhalad.hu>",
        "OPENAI_MODEL": "gpt-6-luna"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hogyhalad-production",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "hogyhalad-production-files"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "TASKS",
            "queue": "hogyhalad-production-tasks"
          }
        ]
      }
    }
  }
}
